<?xml version="1.0" encoding="UTF-8"?>
<fcpxml version="1.14">
  <resources>
    <format id="r1" name="FFVideoFormat1080p30" frameDuration="1/30s" width="1920" height="1080" colorSpace="1-1-1 (Rec. 709)"/>
    <effect id="rBasic" name="Basic Title" uid=".../Titles.localized/Bumper:Opener.localized/Basic Title.localized/Basic Title.moti"/>
    <effect id="rSolid" name="Custom" uid=".../Generators.localized/Solids.localized/Custom.localized/Custom.motn"/>
  </resources>
  <library>
    <event name="Text plans">
      <project name="Text plans fixture">
        <sequence format="r1" duration="8s" tcStart="0s" audioLayout="stereo" audioRate="48k">
          <spine>
            <gap name="Text fixture bed" offset="0s" start="0s" duration="8s">
            <title ref="rBasic" name="Styled Basic Title" lane="1" offset="0s" start="0s" duration="3s" role="titles.main">
              <param name="Size" key="9999/999166631/999166633/5/999166635/3" value="84"/>
              <param name="Tracking" key="9999/999166631/999166633/5/999166635/81/79" value="12"/>
              <text><text-style ref="ts1">Styled </text-style><text-style ref="ts2">title</text-style>
second line</text>
              <text-style-def id="ts1" name="Main"><text-style font="Helvetica" fontFace="Bold" fontSize="84" fontColor="1 0.2 0.1 1" bold="1" strokeColor="0 0 0 1" strokeWidth="-2" kerning="12" alignment="center"/></text-style-def>
              <text-style-def id="ts2" name="Accent"><text-style font="Helvetica" fontFace="Oblique" fontSize="72" fontColor="0.2 0.6 1 0.9" italic="1" strokeColor="1 1 1 1" strokeWidth="1" kerning="4" alignment="center"/></text-style-def>
              <adjust-transform position="20 -12" scale="1.1 0.9" rotation="3" anchor="5 2">
                <param name="position">
                  <keyframeAnimation>
                    <keyframe time="0s" value="0 0" interp="linear" curve="linear"/>
                    <keyframe time="3s" value="100 -25" auxValue="0 0" interp="easeOut" curve="smooth"/>
                  </keyframeAnimation>
                </param>
              </adjust-transform>
              <adjust-blend amount="0.8">
                <param name="amount">
                  <keyframeAnimation>
                    <keyframe time="0s" value="0" interp="linear" curve="linear"/>
                    <keyframe time="1s" value="1" interp="easeIn" curve="smooth"/>
                  </keyframeAnimation>
                </param>
              </adjust-blend>
            </title>
            <caption name="Accessible caption" lane="1" offset="3s" start="0s" duration="2s" role="iTT.en-US.dialogue">
              <text display-style="pop-on" placement="bottom" alignment="center"><text-style ref="cs1">First line
Second line</text-style></text>
              <text-style-def id="cs1" name="Caption"><text-style font="Helvetica" fontFace="Regular" fontSize="48" fontColor="1 1 1 1" backgroundColor="0 0 0 0.75" strokeColor="0 0 0 1" strokeWidth="-1" kerning="5" alignment="center" underline="0"/></text-style-def>
            </caption>
            <video ref="rSolid" name="Custom solid" lane="1" offset="5s" start="0s" duration="3s">
              <param name="Color" key="9999/10008/10006/2/1/1" value="0.2 0.4 0.8 1"/>
            </video>
            </gap>
          </spine>
        </sequence>
      </project>
    </event>
  </library>
</fcpxml>
