<?xml version="1.0" encoding="UTF-8"?>
<fcpxml version="1.14">
  <resources>
    <format id="r1" name="FFVideoFormat1080p30" frameDuration="1/30s" width="1920" height="1080" colorSpace="1-1-1 (Rec. 709)"/>
    <asset id="a1" name="Dialogue" start="0s" duration="30s" hasVideo="1" hasAudio="1" format="r1" audioSources="1" audioChannels="2" audioRate="48k">
      <media-rep kind="original-media" src="file:///tmp/dialogue.mov"/>
    </asset>
    <asset id="a2" name="Music" start="0s" duration="30s" hasVideo="1" hasAudio="1" format="r1" audioSources="1" audioChannels="2" audioRate="48k">
      <media-rep kind="original-media" src="file:///tmp/music.mov"/>
    </asset>
    <media id="c1" name="Reusable compound">
      <sequence format="r1" duration="8s" tcStart="10s" audioLayout="stereo" audioRate="48k">
        <spine>
          <asset-clip ref="a1" name="Compound dialogue" offset="10s" start="20s" duration="4s" audioRole="dialogue"/>
          <sync-clip name="Synchronized pair" offset="14s" start="0s" duration="4s">
            <asset-clip ref="a1" name="Synchronized picture" offset="0s" start="24s" duration="4s" audioRole="dialogue"/>
            <audio ref="a2" name="Connected music" lane="-1" offset="0s" start="8s" duration="4s" role="music"/>
            <sync-source sourceID="storyline">
              <audio-role-source role="dialogue"/>
            </sync-source>
            <sync-source sourceID="connected">
              <audio-role-source role="music" enabled="1" active="1"/>
            </sync-source>
          </sync-clip>
        </spine>
      </sequence>
    </media>
  </resources>
  <library>
    <event name="Story containers">
      <project name="Story containers fixture">
        <sequence format="r1" duration="4s" tcStart="0s" audioLayout="stereo" audioRate="48k">
          <spine>
            <ref-clip ref="c1" name="Trimmed compound" offset="0s" start="12s" duration="4s" useAudioSubroles="1">
              <adjust-transform position="20 -10" scale="1.1 0.9" rotation="3" anchor="2 1"/>
              <live-drawing name="Preserved drawing" lane="1" offset="12s" start="0s" duration="1s" animationType="write-on"/>
              <audio-role-source role="dialogue">
                <adjust-volume amount="-3dB"/>
              </audio-role-source>
            </ref-clip>
          </spine>
        </sequence>
      </project>
    </event>
  </library>
</fcpxml>
