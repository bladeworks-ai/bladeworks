<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fcpxml>
<fcpxml version="1.14">
  <resources>
    <format id="r1" frameDuration="1/30s" width="160" height="90" colorSpace="1-1-1 (Rec. 709)"/>
    <asset id="a1" name="Camera" uid="keyword-metadata-camera" start="0s" duration="5s" hasVideo="1" hasAudio="1" format="r1">
      <media-rep kind="original-media" src="file:///tmp/keyword-metadata-camera.mov"/>
    </asset>
  </resources>
  <library>
    <event name="Metadata">
      <project name="Keyword metadata is not story content">
        <sequence format="r1" duration="2s">
          <spine>
            <asset-clip ref="a1" offset="0s" start="0s" duration="2s">
              <keyword start="1/2s" duration="1s" value="Favorite" note="metadata survives in raw XML"/>
              <marker start="1/2s" duration="1/30s" value="Beat"/>
              <chapter-marker start="1s" duration="1/30s" value="Chapter"/>
              <todo-marker start="3/2s" duration="1/30s" value="Review" completed="0"/>
              <analysis-marker start="0s" duration="1s">
                <stabilization-type value="excessiveShake"/>
              </analysis-marker>
              <rating start="0s" duration="2s" value="favorite"/>
            </asset-clip>
          </spine>
        </sequence>
      </project>
    </event>
  </library>
</fcpxml>
