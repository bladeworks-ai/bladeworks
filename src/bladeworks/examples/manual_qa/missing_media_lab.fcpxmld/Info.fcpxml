<?xml version="1.0"?>
<!DOCTYPE fcpxml>
<fcpxml version="1.14">
  <resources>
    <format id="fmt" frameDuration="1/30s" width="640" height="360" colorSpace="1-1-1 (Rec. 709)"/>
    <asset id="signal" name="Night Signal" start="0s" duration="8s" hasVideo="1" hasAudio="1" videoSources="1" audioSources="1" audioChannels="1" audioRate="48000" format="fmt">
      <media-rep kind="original-media" src="Media/night_signal.mp4"/>
    </asset>
    <asset id="missing" name="intentionally_missing_camera.mov" start="0s" duration="8s" hasVideo="1" hasAudio="1" videoSources="1" audioSources="1" audioChannels="2" audioRate="48000" format="fmt">
      <media-rep kind="original-media" src="Media/intentionally_missing_camera.mov"/>
    </asset>
  </resources>
  <library name="Relink QA">
    <event name="Offline Media">
      <project name="Missing Media Degradation" uid="qa-missing-media">
        <sequence format="fmt" duration="6s" tcStart="0s" tcFormat="NDF" audioLayout="stereo" audioRate="48k">
          <spine>
            <asset-clip ref="signal" name="Online Intro" offset="0s" start="0s" duration="2s" audioRole="dialogue"/>
            <asset-clip ref="missing" name="Offline Middle" offset="2s" start="1s" duration="2s" audioRole="dialogue">
              <adjust-transform position="8 -4" scale="0.82 0.82" rotation="3"/>
            </asset-clip>
            <asset-clip ref="signal" name="Online Outro" offset="4s" start="4s" duration="2s" audioRole="music"/>
          </spine>
        </sequence>
      </project>
    </event>
  </library>
</fcpxml>
